FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

ENV GUNICORN_WORKERS=3
ENV GUNICORN_THREADS=4

CMD ["sh", "-c", "python manage.py migrate && python manage.py bootstrap_admin && python manage.py collectstatic --noinput && gunicorn main.wsgi:application --bind 0.0.0.0:8000 --worker-class gthread --workers $GUNICORN_WORKERS --threads $GUNICORN_THREADS"]
