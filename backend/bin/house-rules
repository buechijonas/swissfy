#!/usr/bin/env python3
import ast
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKIPPED = {".venv", "migrations", "__pycache__"}
BANNED_CALLS = {"getattr", "setattr", "delattr", "hasattr", "isinstance"}


class HouseRules(ast.NodeVisitor):
    def __init__(self, path):
        self.path = path
        self.violations = []

    def report(self, node, message):
        self.violations.append(f"{self.path}:{node.lineno}: {message}")

    def check_docstring(self, node):
        if ast.get_docstring(node, clean=False) is not None:
            self.report(node.body[0], "docstring; explain it with a name or in the README")

    def visit_Module(self, node):
        self.check_docstring(node)
        self.generic_visit(node)

    def visit_ClassDef(self, node):
        self.check_docstring(node)
        self.generic_visit(node)

    def visit_FunctionDef(self, node):
        self.check_docstring(node)
        self.generic_visit(node)

    def visit_AsyncFunctionDef(self, node):
        self.visit_FunctionDef(node)

    def visit_Name(self, node):
        if node.id in BANNED_CALLS:
            self.report(node, f"{node.id}() hides a missing structure; use a mapping or a variant")


def sources():
    for path in sorted(ROOT.rglob("*.py")):
        if not SKIPPED & set(path.relative_to(ROOT).parts):
            yield path


def main():
    violations = []
    for path in sources():
        rules = HouseRules(path.relative_to(ROOT))
        rules.visit(ast.parse(path.read_text(), filename=str(path)))
        violations += rules.violations
    for violation in violations:
        print(violation)
    return 1 if violations else 0


if __name__ == "__main__":
    sys.exit(main())
