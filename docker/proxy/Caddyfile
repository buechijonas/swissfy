:80 {
	encode gzip

	@backend path /api/* /django-admin/* /static/*
	handle @backend {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle {
		map {header.X-Swissfy-App} {app_root} {
			docs /srv/docs
			default /srv/swissfy
		}
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * {app_root}
		try_files {path} /index.html
		file_server
	}
}
