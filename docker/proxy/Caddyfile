:80 {
	handle /api/events/ {
		reverse_proxy events:8000
	}

	@media {
		method GET HEAD
		path_regexp ^/api/(posts/[0-9a-f-]+/(images/[0-9]+|video|thumbnail)|stories/[0-9a-f-]+/image|profiles/[^/]+/pictures/[^/]+|covers)/
	}
	handle @media {
		reverse_proxy media:8000
	}

	@backend path /api/* /django-admin/* /static/*
	handle @backend {
		encode gzip
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle {
		encode gzip
		map {header.X-Swissfy-App} {app_root} {
			docs /srv/docs
			default /srv/swissfy
		}
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * {app_root}
		try_files {path} /index.html
		file_server
	}
}
