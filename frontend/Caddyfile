:80 {
	encode gzip

	@backend path /api/* /django-admin/* /static/*
	handle @backend {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
