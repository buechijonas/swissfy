# Used by compose.prod.yml. Copy to .env and fill in real values before deploying:
#   cp .env.example .env

# Public domain the proxy requests a Let's Encrypt certificate for.
# Must already point (A/AAAA record) at this server, with ports 80 and 443 reachable.
DOMAIN=example.com

# Email Let's Encrypt uses for renewal/expiry notices.
ACME_EMAIL=admin@example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DB_NAME=swissfy
DB_USER=swissfy
DB_PASSWORD=change-me

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# govex (authentik) is the identity provider swissfy delegates login to.
# Must match SWISSFY_CLIENT_ID/SWISSFY_CLIENT_SECRET in govex's .env,
# whose SWISSFY_REDIRECT_URI must be https://<DOMAIN>/api/auth/oidc/callback/.
GOVEX_PUBLIC_URL=https://auth.neotyra.com
GOVEX_ACCOUNT_URL=https://auth.neotyra.com/account
GOVEX_CLIENT_ID=swissfy
GOVEX_CLIENT_SECRET=change-me

# Signs the consent status pushed to govex. Generate with
# `python manage.py consent_signing_key`; its public key goes into
# SWISSFY_CONSENT_KEY in govex's .env.
CONSENT_PRIVATE_KEY=

# Lets wintersehn's monolith read profiles through /api/internal/. Same value
# as SWISSFY_API_TOKEN in wintersehn's .env. Empty disables the internal API.
MONOLITH_API_TOKEN=
